# Copy to ".env" and fill in. NEVER commit or share ".env".
# Make strong random values with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- PostgreSQL (use a NEW password, not the old leaked one) ---
POSTGRES_PASSWORD=CHANGE_ME
PG_URL=postgresql+psycopg2://ghost:CHANGE_ME@localhost:5432/ghost_alert

# --- InfluxDB 2 ---
# Use a NEW, empty bucket: old buckets have integer fields (rssi) that clash with the new float fields.
INFLUX_URL=http://localhost:8086
INFLUX_ORG=ghost_alert_work
INFLUX_BUCKET=ghost_alert_v1
INFLUX_ADMIN_PASSWORD=CHANGE_ME
INFLUX_TOKEN=CHANGE_ME
# Fallback if InfluxDB gives trouble on demo day: TELEMETRY_STORE=memory (data lost on restart)
TELEMETRY_STORE=influx

# --- Gateway (the ESP32 sends this in the X-Gateway-Key header, 16+ characters) ---
GATEWAY_API_KEY=CHANGE_ME

# --- Telegram (optional; without it alerts are printed in the backend log) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Other ---
CORS_ORIGINS=http://localhost:5173
DASHBOARD_URL=http://localhost:5173
# Safety round: 300 s in normal use; 60 s makes the demo react faster
SAFETY_ROUND_S=60
